rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedInVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAuthorizedAdminStorage() {
      return isSignedInVerified() && (
        request.auth.token.email == 'olaademi.ZO@gmail.com' ||
        request.auth.token.adminRole in ['super_admin', 'store_manager', 'content_manager']
      );
    }

    function isValidImageUpload() {
      return request.resource != null &&
             request.resource.size <= 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Customer profile avatars: owner-only read/write with size & image content-type checks
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      isValidImageUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Storefront public media folders: public read, verified admin write/delete only
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAuthorizedAdminStorage() && isValidImageUpload();
      allow delete: if isAuthorizedAdminStorage();
    }

    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if isAuthorizedAdminStorage() && isValidImageUpload();
      allow delete: if isAuthorizedAdminStorage();
    }

    match /banners/{sectionId}/{fileName} {
      allow read: if true;
      allow write: if isAuthorizedAdminStorage() && isValidImageUpload();
      allow delete: if isAuthorizedAdminStorage();
    }

    match /collections/{collectionId}/{fileName} {
      allow read: if true;
      allow write: if isAuthorizedAdminStorage() && isValidImageUpload();
      allow delete: if isAuthorizedAdminStorage();
    }

    match /store/{fileName} {
      allow read: if true;
      allow write: if isAuthorizedAdminStorage() && isValidImageUpload();
      allow delete: if isAuthorizedAdminStorage();
    }
  }
}

# Cloud Functions Environment / Secret Configuration for ZEECROWN STORE
# Set sensitive keys using: firebase functions:secrets:set <SECRET_NAME>
# Never place these keys in Android client code or public Firestore settings.

ZEECROWN_FIRESTORE_DB_ID=ai-studio-android-zeecrown-dd5ff843-a456-4fda-9689-4c093932b633
APP_BASE_URL=https://zeecrownstore.com

# Email Provider (RESEND | SENDGRID | SMTP)
EMAIL_PROVIDER=RESEND
EMAIL_FROM_ADDRESS=orders@zeecrownstore.com
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS Provider (TERMII | TWILIO)
SMS_PROVIDER=TERMII
TERMII_API_KEY=
TERMII_SENDER_ID=ZEECROWN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Courier Webhook Shared Secret
COURIER_WEBHOOK_SECRET=

# Server-side AI Concierge (optional for web Cloud Functions; fallback works without key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_RATE_LIMIT_PER_MIN=15
